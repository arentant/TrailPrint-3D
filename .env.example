# Browser sign-in (required for the browser edition; server-only variables).
# Create a Google OAuth Web application; see docs/vercel-deployment.md.
AUTH_URL=http://localhost:5173
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Exact email addresses, separated by commas. No wildcard or domain access.
ALLOWED_EMAILS=you@example.com,teammate@example.com

# Enter the OpenTopography API key in the app sidebar (recommended).
# Optional desktop development defaults:
# https://portal.opentopography.org/requestService?service=api
# OPENTOPOGRAPHY_API_KEY=
# VITE_OPENTOPOGRAPHY_API_KEY=

# Optional desktop V8 heap limit in MB (8192 or 12288 for very large meshes).
# TRAILPRINT_HEAP_MB=8192
