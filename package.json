{
  "name": "trailprint-3d",
  "version": "0.1.0",
  "description": "TrailPrint 3D — Turn GPX tracks into 3D terrain keepsakes",
  "main": "./out/main/index.js",
  "author": "TrailPrint",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=8192 electron-vite dev",
    "build": "electron-vite build",
    "preview": "NODE_OPTIONS=--max-old-space-size=8192 electron-vite preview",
    "package": "npm run build && electron-builder",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json --composite false && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.api.json",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "test:web": "playwright test",
    "test:export": "node --test tests/export/*.test.mjs",
    "test:api": "node --test tests/runtime/*.test.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "archiver": "^7.0.1",
    "fflate": "^0.8.3",
    "geotiff": "^3.0.5",
    "leaflet": "^1.9.4",
    "leaflet-rotate": "^0.2.8",
    "pinia": "2.3.1",
    "three": "^0.184.0",
    "three-bvh-csg": "^0.0.18",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/archiver": "^7.0.0",
    "@types/leaflet": "^1.9.15",
    "@types/node": "22.14.1",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-vue": "5.2.3",
    "electron": "35.1.5",
    "electron-builder": "26.0.12",
    "electron-vite": "3.1.0",
    "typescript": "5.8.3",
    "vite": "6.3.2",
    "vue-tsc": "2.2.8"
  },
  "build": {
    "appId": "com.trailprint.app",
    "productName": "TrailPrint 3D",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
